# =============================================================================
# .env.example — copy this to .env and fill in real values
# .env is gitignored and must NEVER be committed
# =============================================================================

# Spring profile to activate (default, dev, staging, prod)
SPRING_PROFILES_ACTIVE=default

# Database connection (if applicable)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/countries
SPRING_DATASOURCE_USERNAME=appuser
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
